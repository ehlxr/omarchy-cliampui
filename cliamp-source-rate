#!/bin/bash

# Prints the native sample rate of the track cliamp is playing, or nothing.
#
# This exists because cliamp always outputs one fixed rate (config sample_rate,
# default 44100) and resamples anything else internally, before PipeWire sees it.
# Watching the graph therefore proves nothing about the file, so the source rate has
# to come from the file itself.
#
# Subsonic stream URLs already carry a salted auth token, so getSong can be asked
# without this script ever handling a credential.

set -uo pipefail

path="${1:-}"
[[ -n $path ]] || exit 0

case "$path" in
  https://*/rest/stream*)
    # Rebuild the same query against getSong, keeping only the auth and id fields.
    base="${path%%\?*}"
    query="${path#*\?}"
    host="${base%/rest/stream}"

    kept=""
    IFS='&' read -ra fields <<< "$query"
    for field in "${fields[@]}"; do
      case "${field%%=*}" in
        id|u|t|s|c|v) kept="${kept:+$kept&}$field" ;;
      esac
    done
    [[ -n $kept ]] || exit 0

    # The retained t/s fields are credentials, and /proc exposes process argv, so
    # the host and auth query cross to python on stdin and the URL is built inside
    # it: the token never appears in an argv or the environment.
    printf '%s\x1f%s' "$host" "$kept" | python3 -c '
import json, sys, urllib.request
pieces = sys.stdin.buffer.read().split(b"\x1f", 1)
if len(pieces) != 2:
    raise SystemExit(1)
host, auth = pieces[0].decode("utf-8"), pieces[1].decode("utf-8")
rate = 0
try:
    with urllib.request.urlopen(host + "/rest/getSong?" + auth + "&f=json", timeout=5) as response:
        raw = response.read(1048576 + 1)
    if len(raw) <= 1048576:
        data = json.loads(raw.decode("utf-8", "replace"))
        rate = ((data.get("subsonic-response") or {}).get("song") or {}).get("samplingRate") or 0
except Exception:
    rate = 0
if rate:
    print(rate)
' 2>/dev/null | head -1
    ;;

  http://*|https://*)
    # A radio stream has no fixed native rate worth reporting.
    exit 0
    ;;

  *)
    [[ -r $path ]] || exit 0
    ffprobe -v error -select_streams a:0 -show_entries stream=sample_rate \
      -of default=noprint_wrappers=1:nokey=1 "$path" 2>/dev/null | head -1
    ;;
esac

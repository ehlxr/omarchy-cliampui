[Unit]
Description=cliamp headless music daemon
# PipeWire arrives with the graphical session, and so does the shell that drives this.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# The unit is enabled, so it would survive a marketplace removal that reuses the
# plugin checkout path. ExecStart therefore points at a guard installed outside
# the checkout: it verifies the checkout is still the expected, user-owned
# io.github.ehlxr.cliampui tree before exec-ing the plugin's entry point, and
# when the checkout is missing or foreign it triggers the (never-enabled)
# cliamp-daemon-cleanup.service, which stops, de-registers and removes this
# owned unit. See cliamp-daemon-guard / cliamp-daemon-cleanup.
ExecStart=%h/.local/share/omarchy/cliampui/cliamp-daemon-guard
Restart=on-failure
RestartSec=5

# cliamp's log and history carry Navidrome stream URLs with the salted token, so nothing it writes is world-readable.
UMask=0077
# systemd bind-mounts this writable, which is what carves it out of the read-only home.
ConfigurationDirectory=cliamp
ConfigurationDirectoryMode=0700
ProtectSystem=strict
# strict leaves /home, /root and /run/user to ProtectHome, so home needs this line.
ProtectHome=read-only
# ProtectHome takes /run/user too, and the PipeWire socket lives there.
ReadWritePaths=%t
# The rate pin is read and removed here, and the panel helper creates the directory from outside this unit.
ReadWritePaths=-%S/omarchy/cliampui
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# AF_UNIX carries the control socket and PipeWire, IP carries Navidrome, and glibc resolves names over NETLINK_ROUTE.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=graphical-session.target

#!/bin/bash

# ExecStart for cliamp-daemon.service and the entry used by the panel's "Start
# cliamp". Starts cliamp headless with the saved playlist, then continues the
# last track + position the same way the terminal launcher does.
#
# cliamp fixes its output rate at launch and has no IPC command to change it, so the
# only way to play a file at its native rate is to start cliamp at that rate. The panel
# writes the wanted rate here and restarts the unit; this script is what reads it.
#
# An empty or missing file means "leave it to cliamp", which is its configured default.

set -uo pipefail

# Whatever cliamp writes from here (resume.json, its log) stays owner-only when this
# entry runs from the panel, outside the systemd unit whose UMask=0077 covers it.
umask 077

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/cliampui"
rate_file="$state_dir/sample-rate"
plugin_dir="$HOME/.config/omarchy/plugins/io.github.ehlxr.cliampui"
playlist="$("$plugin_dir/cliamp-pick-playlist")"

rate=""
if [[ -r $rate_file ]]; then
  rate="$(head -1 "$rate_file" 2>/dev/null | tr -cd '0-9')"
  # One shot: the pin survives only the restart that wrote it, never a later one.
  rm -f "$rate_file"
fi

if [[ -n $rate && $rate -gt 0 ]]; then
  /usr/bin/cliamp --daemon --playlist "$playlist" --sample-rate "$rate" &
else
  /usr/bin/cliamp --daemon --playlist "$playlist" &
fi
CLIAMP_PID=$!

# Resume the saved track + position, then stay as the daemon's parent so a
# supervising unit (or the panel) keeps seeing the service as alive.
exec "$plugin_dir/cliamp-resume-ipc" "$CLIAMP_PID"